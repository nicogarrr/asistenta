# Pin exact versions (npm dedupe keeps a single copy per package).
# typebox MUST match pi-agent-core's own pin exactly (1.3.27): two copies in
# the tree means schemas fail `instanceof TSchema` inside tool validation.
save-exact=true
engine-strict=true
fund=false
audit=false

# min-release-age is intentionally NOT set. pi-agent-core publishes ~1.5x/week and
# targets the newest fix release, which is by definition <48h old. We get supply
# chain hardening from `save-exact` + SLSA provenance on the pi packages instead.