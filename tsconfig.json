{
  "compilerOptions": {
    "target": "ES2024",
    // DOM is required by Playwright: code passed to `page.evaluate` is compiled by
    // TypeScript against browser globals even though it never runs in Node. Node
    // types stay on, and the only overlap that matters (fetch, URL, AbortSignal)
    // resolves to the same shapes in both.
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
