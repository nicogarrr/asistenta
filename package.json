{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal always-on agent with computer use and messaging channels",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pa": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-page-scripts.mjs",
    "build:instalador": "node scripts/windows-app/build-installer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --error-on-warnings .",
    "lint:check": "biome check --error-on-warnings .",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "qa:daemon": "bash scripts/qa-daemon/smoke.sh",
    "test:e2e": "vitest run test/e2e-scenarios.test.ts test/e2e-agent-loop.test.ts test/e2e-memory-scopes.test.ts",
    "start": "node dist/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@huggingface/transformers": "4.3.0",
    "croner": "10.0.1",
    "ffmpeg-static": "5.3.0",
    "grammy": "1.46.0",
    "imapflow": "2.2.1",
    "lamejs": "1.2.1",
    "node-ical": "0.27.2",
    "nodemailer": "10.3.1",
    "ogg-opus-decoder": "1.7.5",
    "onnxruntime-node": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "teleproto": "1.230.0",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
