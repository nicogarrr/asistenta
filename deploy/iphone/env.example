# server/.env del servidor hidagent (esp32-iphone-agent).
# install-wsl.sh lo copia a ~/esp32-iphone-agent/server/.env si no existe.
# LA CLAVE NO VA EN EL REPO NI POR CHAT: pegala tu mismo en ese .env (permisos 600).

# --- Modelo de vision GRATIS (regla EUR 0): Gemini API (AI Studio), endpoint compatible OpenAI ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_EXTRA_BODY='{}'
# Gemini rechaza max_tokens en algunos modelos nuevos: "auto" lo detecta.
# LLM_TOKEN_PARAM=auto

# El actor da un paso por captura: una tarea de 20 pasos son ~20 peticiones.
# El plan gratuito de Gemini tiene un tope diario de peticiones: si se agota,
# el agente se para a mitad de tarea. Alternativa gratuita (otro tope, calidad
# variable, sin verificar con capturas de iPhone):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<un modelo :free con entrada de imagen, ver openrouter.ai/models?input_modalities=image>

AIRPLAY_NAME='iPhone Agent'
PORT=8890
DEVICE_PORT=7300
HIDAGENT_DEBUG=0
