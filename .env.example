# Opciones no secretas. Copia a .env y usa:
# node --env-file=.env dist/cli.js doctor
# El CLI carga .env desde el directorio de trabajo; el entorno ya presente gana.
# No pongas tokens ni claves aquí. Usa el almacén privado descrito en README.md.

# opencode (por defecto), openrouter u opencode-local.
# Los presets NO garantizan precio cero ni disponibilidad.
PA_PROVIDER_PRESET=opencode

# Sin control de escritorio: adecuado para un primer arranque sin escritorio.
# En Windows, elimina esta línea si necesitas y has verificado esas funciones.
PA_DESKTOP=off

# Opcionales. No actives rutas/modelos de ejemplo sin revisarlos.
# PA_STATE_DIR=/ruta/privada/personal-agent
# PA_MODEL=nombre-del-modelo-verificado
# PA_BASE_URL=https://endpoint-verificado
# PA_BROWSER_CHANNEL=chromium
# PA_TOOL_TIMEOUT_MS=120000
# PA_RUN_TIMEOUT_MS=900000
# Puerta de exfiltración tras leer contenido privado (activa por defecto; 0 la apaga).
# PA_TAINT_GATE=1

# Enrutador web (docs/web-router.md): tope de coste por llamada en EUR.
# Por defecto 0 (solo backends gratis; uno de pago nunca se llama).
# PA_WEB_MAX_COST_EUR=0
# Investigación amplia (docs/investiga-amplio.md): 1 = activa `/investiga amplio <pregunta> | a, b, c`.
# PA_INVESTIGA_AMPLIO=
# Correo como canal (docs/correo-canal.md), apagado por defecto. Solo remitentes de la lista con dkim=pass.
# PA_CORREO_CANAL=
# PA_CORREO_CANAL_REMITENTES=
# PA_CORREO_CANAL_AUTHSERV=mx.google.com

# Vault por defecto: DPAPI en Windows; portable en otros sistemas.
# No selecciones portable en Windows como atajo ante errores de DPAPI.
# PA_SECRETS_FILE=/ruta/privada/secrets.json

# Retención de conversaciones: el daemon borra cada día (04:00) las sesiones terminadas
# con más de N días. 0 la apaga. Por defecto 365.
# PA_SESSION_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Referencia completa de variables PA_* (todas opcionales, comentadas).
# test/env-example.test.ts exige que toda PA_* que lea src/ esté aquí: si añades
# una, documéntala en su sección con una línea.
# ---------------------------------------------------------------------------

# --- Modelo y proveedor ---
# PA_PROVIDER=nombre-del-proveedor            # se deduce del preset si falta
# PA_MODEL_VARIANT=                           # variante del modelo (p. ej. nivel de razonamiento)
# PA_FALLBACK_MODEL=                          # modelo de respaldo si se agota la cuota del principal
# PA_API_KEY=                                 # solo para pruebas; la clave real va en el almacén privado
# PA_CONTEXT_WINDOW=1048576                   # ventana de contexto real del modelo (tokens)
# PA_MAX_OUTPUT_TOKENS=32000                  # tope de tokens de salida por respuesta
# PA_COMPACT_TOKENS=                          # tokens a partir de los que se resume el historial
# PA_PRICE_INPUT_PER_MTOK=                    # precio EUR por millón de tokens de entrada (para /consumo)
# PA_PRICE_OUTPUT_PER_MTOK=                   # precio EUR por millón de tokens de salida
# PA_DAILY_BUDGET_EUR=0                       # tope de gasto diario; 0 = sin tope
# PA_HEALTH_GEMINI_MODEL=                     # modelo que usa pa doctor para comprobar Gemini
# PA_HEALTH_OPENROUTER_MODEL=                 # modelo que usa pa doctor para comprobar OpenRouter

# --- Bucle del agente ---
# PA_IDLE_TIMEOUT_MS=180000                   # corta un turno si el proveedor no manda nada en este tiempo
# PA_MAX_TOOL_CALLS=60                        # tope de llamadas a herramientas por petición
# PA_RETRY_ATTEMPTS=3                         # reintentos ante 429/5xx del proveedor
# PA_RETRY_BASE_MS=1500                       # espera inicial entre reintentos
# PA_RETRY_MAX_MS=20000                       # espera máxima entre reintentos
# PA_BUILTIN_SKILLS=1                         # 0 desactiva las skills que vienen de serie
# PA_SEMANTIC_RECALL=                         # recuerdo semántico de memoria (embeddings locales)
# PA_MEMORY_CONSOLIDATE=1                     # consolidación nocturna de la memoria; 0 la apaga
# PA_PROJECT_ROOTS=                           # carpetas (separadas por ;) donde se leen ASISTENTA.md/AGENTS.md de proyecto; off = apagado
# PA_WEBHOOK_PORT=                            # webhook local POST /hook/<rutina> en 127.0.0.1 (vacío = apagado)
# PA_WEBHOOK_TOKEN=                           # token Bearer obligatorio, mínimo 24 caracteres
# PA_WEBHOOK_ROUTINES=                        # rutinas permitidas, separadas por comas (vacío = todas)
# PA_WEBHOOK_PER_MINUTE=10                    # peticiones por minuto (también las fallidas)

# --- Estado, logs y copias ---
# PA_LOG_LEVEL=info                           # debug | info | warn | error
# PA_TIMEZONE=Europe/Madrid                   # zona para «hoy», recordatorios y agenda
# PA_VAULT_BACKEND=                           # dpapi (Windows) | portable
# PA_BACKUP_DIR=                              # carpeta de copias de seguridad
# PA_BACKUP_MIRROR=                           # segunda carpeta donde replicar las copias

# --- Daemon: rutinas, resumen y vigilancias ---
# PA_FILE_RETENTION_DAYS=0                    # borra a las 04:00 log/ diarios, screenshots/, capturas de voice/ y media/received de más de N días; 0 = nunca
# PA_DOCUMENT_RETENTION_DAYS=0                # olvida documentos indexados hace más de N días (04:00); 0 = nunca
# PA_CRON=                                    # tareas programadas: «horario<TAB>orden», una por línea
# PA_ROUTINE_CATCHUP=1                        # 0 = no recuperar rutinas perdidas con el PC apagado
# PA_CRON_COMANDOS=0                          # 1 = rutinas de comando sin modelo (/cron comando, docs/rutinas-comando.md)
# PA_SHELL_SANDBOX=off                         # docker = la herramienta shell corre en un contenedor sin red (docs/shell-sandbox.md)
# PA_SHELL_SANDBOX_IMAGE=                     # vacío = powershell 7.4 fijada por digest; imagen del contenedor con PA_SHELL_SANDBOX=docker
# PA_AUDIO_TELE=0                            # 1 permite «reprodúcelo en la tele» (servidor efímero solo para la IP de la tele)
# PA_BRIEFING=0                               # 1 activa el resumen matinal
# PA_BRIEFING_HOUR=8                          # hora del resumen matinal
# PA_BRIEFING_VOZ=0                           # 1 manda también el resumen como nota de voz (tras el texto, sin esperarla)
# PA_BRIEFING_LAT=                            # latitud para el tiempo del resumen
# PA_BRIEFING_LON=                            # longitud para el tiempo del resumen
# PA_BRIEFING_PLACE=                          # nombre del lugar que se muestra con el tiempo
# PA_OCR_WATCH_DIR=                           # carpeta vigilada para OCR automático de documentos
# PA_OCR_WATCH_MODE=                          # modo del vigilante de OCR

# --- Panel web e integraciones ---
# PA_WEB_PORT=                                # puerto del panel local (solo 127.0.0.1)
# PA_WEB_TOKEN=                               # token del panel; si falta se genera uno
# PA_WEB_ALLOWED_HOSTS=                       # nombres extra aceptados en Host (proxy propio)
# PA_FETCH_ALLOWED_HOSTS=                     # hosts privados que fetch puede leer (lista)
# PA_MCP_SERVERS=                             # servidores MCP (JSON)
# PA_IPHONE_URL=                              # URL del atajo/puente del iPhone
# PA_OPENGYM_URL=                             # URL de OpenGym
# PA_OPENGYM_TOKEN=                           # token de OpenGym (mejor en el almacén privado)
# PA_QA_CHANNEL=0                             # 1 = canal de QA local (solo pruebas)
# PA_QA_OWNER_DM=0                            # 1 = el canal de QA también atiende el DM del dueño (solo pruebas)

# --- Navegador y descargas ---
# PA_CURL_IMPERSONATE=                        # ruta a curl-impersonate para webs con antibot
# PA_DOWNLOAD_COOKIES_BROWSER=                # navegador del que tomar cookies para descargas
# PA_EBOOK_CONVERT=                           # ruta a ebook-convert (Calibre)

# --- Escritorio (Computer Use) ---
# PA_SCREENSHOT_MAX_EDGE=1280                 # lado máximo de las capturas
# PA_SCREENSHOT_QUALITY=80                    # calidad JPEG de las capturas
# PA_COMPUTER_USE=1                           # 0 = interruptor: Asistenta no ve ni toca el escritorio
# PA_COMPUTER_PASTE_SETTLE_MS=400             # espera tras Ctrl+V antes de devolver el portapapeles (100–5000)
# PA_COMPUTER_PASTE_NO_HISTORY=0            # 1 = lo que Computer Use pega no entra en el historial Win+V ni en la nube
# PA_VERIFY_ACTIONS=1                         # comprobar la pantalla tras cada acción
# PA_VERIFY_SETTLE_MS=350                     # espera antes de esa comprobación

# --- Tele ---
# PA_TV_KEY_TIMEOUT_MS=                       # espera máxima de una tecla del mando de la tele (1000–30000 ms)
# PA_TV_CMD_TIMEOUT_MS=                       # espera máxima de respuesta de una orden a la tele (2000–60000 ms, por defecto 10000)
# PA_TV_KEY_GRACE_MS=                         # margen extra tras la tecla antes de dar la orden por fallida

# --- Voz ---
# PA_WAKE_ENGINE=whisper                      # whisper | oww (palabra de activación)
# PA_WAKE_OWW_MODEL=                          # modelo openWakeWord
# PA_WAKE_OWW_THRESHOLD=0.5                   # umbral de openWakeWord
# PA_SPEAKER_VERIFY=0                         # 1 = solo responde a la voz registrada
# PA_SPEAKER_THRESHOLD=                       # umbral de verificación de la voz
# PA_SPEAKER_MARGIN=                          # margen sobre el umbral
# PA_TTS_VOICE=                               # voz de Windows (SAPI)
# PA_TTS_RATE=                                # velocidad de la voz
# PA_TTS_VOLUME=                              # volumen de la voz
# PA_TTS=                                     # piper = usar siempre Piper (necesita PA_PIPER_MODEL)
# PA_PIPER_MODEL=                             # modelo .onnx de Piper: activa la voz local de respaldo (docs/voz-piper.md)
# PA_PIPER_BIN=                               # ruta a piper(.exe) si no está en el PATH

# --- Auto-mejora (evolve) ---
# PA_EVOLVE_PROPOSER=                         # comando que propone cambios en pa evolve
# PA_EVOLVE_DIR=                              # carpeta de trabajo de evolve

# Solo pruebas (canal QA): una línea del buzón cuenta como chat privado del dueño. Apagado por defecto.
# PA_QA_OWNER_DM=1
